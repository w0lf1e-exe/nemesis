# N.E.M.E.S.I.S server configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Port the API server listens on
PORT=4317

# Secret bearer token the web console must present on every request.
# Generate one with: openssl rand -hex 32
NEMESIS_API_KEY=change-me-to-a-long-random-secret

# Origin allowed to call this API (your web console URL)
WEB_ORIGIN=http://localhost:5173

# Absolute path to the local git repository the Dev module operates on.
# Defaults to the directory the server process was started in.
DEV_REPO_PATH=

# Max lifetime (ms) for a single spawned tool job before it is killed
JOB_TIMEOUT_MS=300000

# Max bytes of combined stdout/stderr buffered per job before truncation
JOB_MAX_OUTPUT_BYTES=2000000

# --- Kali Linux VM integration (optional) ---
# Leave KALI_SSH_HOST blank to disable Kali VM features entirely.
# Only key-based auth is supported — generate a dedicated keypair, e.g.:
#   ssh-keygen -t ed25519 -f ~/.ssh/nemesis_kali -N ""
#   ssh-copy-id -i ~/.ssh/nemesis_kali.pub kali@<your-vm-ip>
KALI_SSH_HOST=
KALI_SSH_PORT=22
KALI_SSH_USER=kali
KALI_SSH_KEY_PATH=

# Directory on the Kali VM where you drop files (hash dumps, etc.) for the
# credential-audit tools to reference by filename. Must already exist.
KALI_WORK_DIR=/home/kali/nemesis-workspace

# How long an Engagement Scope confirmation stays active before the
# vuln-scan / credential-audit tools lock again and need re-confirming (ms).
SCOPE_DURATION_MS=14400000
